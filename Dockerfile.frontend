# ========== Stage 1: Build ==========
FROM node:20-alpine AS builder
WORKDIR /app

# نسخ ملفات الاعتماديات أولاً (لاستغلال طبقات Docker cache)
COPY package.json package-lock.json ./
RUN npm ci

# نسخ ملفات الواجهة الأمامية فقط
COPY tsconfig*.json vite.config.ts tailwind.config.js postcss.config.js index.html ./
COPY src ./src
COPY public ./public

# تمرير رابط الـ API كمتغير بناء
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# بناء الواجهة (Vite)
RUN npm run build

# ========== Stage 2: Runtime ==========
FROM node:20-alpine AS runtime
WORKDIR /app

# نسخ node_modules (التي تحتوي serve) و dist فقط
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production
ENV HOST=0.0.0.0
EXPOSE 8080

# تشغيل serve على 0.0.0.0 (ضروري لـ Railway)
CMD ["sh", "-c", "./node_modules/.bin/serve -s dist -l tcp://0.0.0.0:${PORT:-8080}"]
