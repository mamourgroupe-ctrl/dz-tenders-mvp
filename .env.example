APP_ENV=development
LOG_LEVEL=INFO
DB_PATH=storage/tenders.db
DRY_RUN=true

# W7 - storage lock
LOCK_TIMEOUT_SECONDS=900
INCLUDE_SAMPLES=false

# W17 - freshness filter
FRESHNESS_WINDOW_DAYS=90
FRESHNESS_ENABLED=true

# W18 - Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# W19 - SMTP digest email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=

# W20 - Strict product matching
REQUIRE_PRODUCTS=true
ALLOW_NEWS_AS_TENDERS=false

# MounakassatDZ authenticated crawler
MOUN_PHONE=
MOUN_PASSWORD=

# Frontend (place in a Vite .env file when using the FastAPI service)
VITE_API_URL=http://localhost:8000/api

# FastAPI read-only API (backend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# ---------------------------------------------------------------------------
# Public platform (webapp/) — Phase 1
# ---------------------------------------------------------------------------
# Separate database from the legacy pipeline; relative paths resolve from the
# repository root. Use a Postgres URL in production if preferred.
APP_DATABASE_URL=sqlite+pysqlite:///storage/platform.db
# Public origin used in canonical links, sitemaps and robots.txt (empty derives
# it from the incoming request).
APP_BASE_URL=http://localhost:8000
APP_CONTACT_EMAIL=contact@example.dz
APP_CONTACT_PHONE=
# Pagination and sessions
APP_PAGE_SIZE=12
APP_MAX_PAGE_SIZE=48
APP_SESSION_TTL_HOURS=72
# Set to true behind HTTPS; defaults to true when APP_ENV=production.
APP_COOKIE_SECURE=false
# Arabic search: falls back to LIKE when FTS5 is unavailable.
APP_FTS_ENABLED=true
# Login throttling: attempts per phone and per IP inside the window.
APP_LOGIN_RATE_LIMIT=5
APP_IP_RATE_LIMIT=10
APP_RATE_LIMIT_WINDOW_MINUTES=15
# Uploads (payment proofs, attachments) and their size ceiling.
APP_UPLOAD_DIR=storage/uploads
APP_MAX_UPLOAD_BYTES=5242880
# Optional JSON override for the wilaya list (see docs/AUDIT.md, open question O1)
APP_WILAYAS_FILE=
# Optional bootstrap administrator created by `python -m webapp.cli seed`.
APP_ADMIN_PHONE=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
# Trust X-Forwarded-* headers only behind a known reverse proxy.
APP_TRUST_PROXY=false

