APP_ENV=development
LOG_LEVEL=INFO
DB_PATH=storage/tenders.db
DRY_RUN=true

# W7 - storage lock
LOCK_TIMEOUT_SECONDS=900
INCLUDE_SAMPLES=false

# W17 - freshness filter
FRESHNESS_WINDOW_DAYS=90
FRESHNESS_ENABLED=true

# W18 - Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# W19 - SMTP digest email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=

# W20 - Strict product matching
REQUIRE_PRODUCTS=true

# Frontend (place in a Vite .env file when using the FastAPI service)
VITE_API_URL=http://localhost:8000/api

# FastAPI read-only API (backend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
